<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.undefinedvars.attendance.controller.StatisticsController"
      spacing="10">

    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <Label text="Absence Statistics"/>

    <Label fx:id="summaryLabel"/>

    <TableView fx:id="statisticsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn" text="Student Name" prefWidth="200"/>
            <TableColumn fx:id="totalColumn" text="Total Marked" prefWidth="100"/>
            <TableColumn fx:id="absentColumn" text="Absent" prefWidth="80"/>
            <TableColumn fx:id="lateColumn" text="Late" prefWidth="80"/>
            <TableColumn fx:id="absenceRateColumn" text="Absence Rate" prefWidth="120"/>
        </columns>
        <placeholder>
            <Label text="No statistics yet. Add students and mark attendance first."/>
        </placeholder>
    </TableView>

    <Button fx:id="refreshButton"
            text="Refresh Statistics"
            onAction="#handleRefresh"
            maxWidth="Infinity"/>

</VBox>