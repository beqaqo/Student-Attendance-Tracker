<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.undefinedvars.attendance.controller.AttendanceController"
      spacing="10">

    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <!-- Date selector row -->
    <HBox spacing="8" alignment="CENTER_LEFT">
        <DatePicker fx:id="datePicker" promptText="Pick a date" onAction="#handleDateChange"/>
        <Button text="Load" onAction="#handleDateChange"/>
    </HBox>

    <!-- Feedback label (green on success, red on error) -->
    <Label fx:id="statusLabel"/>

    <!-- Student list with inline status selector -->
    <TableView fx:id="attendanceTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn" text="Student Name" prefWidth="280"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="180"/>
        </columns>
        <placeholder>
            <Label text="No students found. Add students in the Students tab first."/>
        </placeholder>
    </TableView>

    <!-- Save button -->
    <Button fx:id="saveButton" text="Save Attendance" onAction="#handleSave"
            maxWidth="Infinity"/>

</VBox>
