<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>

<!--
    Root layout: a TabPane with two tabs, Students and Attendance.
    Each tab loads its own FXML via fx:include, so each sub-controller
    remains the root controller of its own file (JavaFX requirement).
    The controller factory in AttendanceApp routes each controller class
    to its injected instance.
-->
<TabPane xmlns:fx="http://javafx.com/fxml" tabClosingPolicy="UNAVAILABLE">

    <tabs>
        <!-- Students Tab -->
        <Tab text="Students">
            <content>
                <fx:include source="students_view.fxml"/>
            </content>
        </Tab>

        <!-- Attendance Tab -->
        <Tab text="Attendance">
            <content>
                <fx:include source="attendance_view.fxml"/>
            </content>
        </Tab>
    </tabs>

</TabPane>